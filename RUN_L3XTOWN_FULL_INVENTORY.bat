@echo off
setlocal EnableExtensions
title L3XTOWN GUITAR - FULL PATH INVENTORY
set "LOG=%~dp0L3XTOWN_INVENTORY_RUN_LOG.txt"
set "SAMPLE_MAP=%~dp0L3XTOWN_SAMPLE_MAP.csv"
set "LIBRARY_ROOT=F:\POP PUNK GUITAR ULTIMATE\Samples\SourceLibraries\L3XTOWN GUITAR"
set "TMPPY=%TEMP%\BUILD_L3XTOWN_INVENTORY_%RANDOM%.py"
set "TMPB64=%TEMP%\BUILD_L3XTOWN_INVENTORY_%RANDOM%.b64"
set "PYTHON=%LOCALAPPDATA%\PythonPortable\python.exe"
set "RC=2"
echo ============================================================
echo L3XTOWN GUITAR - FULL PATH INVENTORY
echo READ-ONLY SCAN - NO AUDIO OR PLUGIN TESTS
echo ============================================================
echo.
> "%LOG%" echo L3XTOWN inventory started: %DATE% %TIME%
echo [1/4] Checking files...
if not exist "%SAMPLE_MAP%" (
  echo ERROR: L3XTOWN_SAMPLE_MAP.csv is missing beside this BAT.
  >>"%LOG%" echo ERROR: Sample map missing beside BAT.
  goto :finish
)
if not exist "%LIBRARY_ROOT%" (
  echo ERROR: Source library folder not found:
  echo "%LIBRARY_ROOT%"
  >>"%LOG%" echo ERROR: Source library folder not found.
  goto :finish
)
echo [2/4] Preparing built-in inventory script...
where certutil >nul 2>nul
if errorlevel 1 (
  echo ERROR: Windows certutil utility was not found.
  >>"%LOG%" echo ERROR: certutil not found.
  goto :finish
)
more +36 "%~f0" > "%TMPB64%"
certutil -f -decode "%TMPB64%" "%TMPPY%" >nul 2>&1
if errorlevel 1 (
  echo ERROR: Could not prepare the built-in Python script.
  >>"%LOG%" echo ERROR: certutil could not decode embedded script.
  goto :finish
)
echo [3/4] Checking Python...
if not exist "%PYTHON%" (
  set "PYTHON="
  where py >nul 2>nul
  if not errorlevel 1 set "PYTHON=py"
)
if not defined PYTHON (
  echo ERROR: Python not found. Install Python 3 or the py launcher.
  >>"%LOG%" echo ERROR: Python not found.
  goto :finish
)
echo [4/4] Starting read-only inventory. It may take several minutes.
echo Source WAV files will not be changed.
>>"%LOG%" echo Starting read-only inventory...
%PYTHON% "%TMPPY%" --root "%LIBRARY_ROOT%" --sample-map "%SAMPLE_MAP%" --out "%~dp0L3XTOWN_FULL_INVENTORY.csv" --report "%~dp0L3XTOWN_INVENTORY_RECONCILIATION.csv" >>"%LOG%" 2>&1
set "RC=%ERRORLEVEL%"
if "%RC%"=="0" (
  echo SUCCESS: Two CSV reports created beside this BAT.
  >>"%LOG%" echo SUCCESS: Inventory reports created.
) else (
  echo ERROR: Scan failed. Full details are in the log.
  >>"%LOG%" echo ERROR: Scan exit code %RC%.
)
:finish
del "%TMPPY%" >nul 2>nul
del "%TMPB64%" >nul 2>nul
echo.
echo Log: "%LOG%"
echo Window remains open. Press any key to close.
pause >nul
exit /b %RC%
goto :eof
